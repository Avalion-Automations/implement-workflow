{
  "description": "Implement workflow lifecycle telemetry. These hooks update only an explicitly selected Implement run/task context and never approve plans or merges.",
  "hooks": {
    "SubagentStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/skills/build/scripts/build-status.mjs\" hook",
        "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\build\\scripts\\build-status.mjs\" hook",
        "timeout": 10,
        "statusMessage": "Updating Implement agent status"
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/skills/build/scripts/build-status.mjs\" hook",
        "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\build\\scripts\\build-status.mjs\" hook",
        "timeout": 10,
        "statusMessage": "Closing Implement agent status"
      }]
    }],
    "PreToolUse": [{
      "matcher": "^(Bash|apply_patch)$",
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/skills/build/scripts/build-status.mjs\" hook",
        "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\build\\scripts\\build-status.mjs\" hook",
        "timeout": 10,
        "statusMessage": "Marking Implement task active"
      }]
    }],
    "PostToolUse": [{
      "matcher": "^(Bash|apply_patch)$",
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/skills/build/scripts/build-status.mjs\" hook",
        "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\build\\scripts\\build-status.mjs\" hook",
        "timeout": 10,
        "statusMessage": "Recording Implement tool outcome"
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/skills/build/scripts/build-status.mjs\" hook",
        "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\build\\scripts\\build-status.mjs\" hook",
        "timeout": 10,
        "statusMessage": "Reconciling Implement task status"
      }]
    }]
  }
}
