{
  "description": "Build workflow lifecycle telemetry. These hooks update only an explicitly selected Build run/task context and never approve plans or merges.",
  "hooks": {
    "SubagentStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/skills/build/scripts/build-status.mjs\" hook",
        "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\build\\scripts\\build-status.mjs\" hook",
        "timeout": 10,
        "statusMessage": "Updating Build agent status"
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/skills/build/scripts/build-status.mjs\" hook",
        "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\build\\scripts\\build-status.mjs\" hook",
        "timeout": 10,
        "statusMessage": "Closing Build agent status"
      }]
    }],
    "PreToolUse": [{
      "matcher": "^(Bash|apply_patch)$",
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/skills/build/scripts/build-status.mjs\" hook",
        "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\build\\scripts\\build-status.mjs\" hook",
        "timeout": 10,
        "statusMessage": "Marking Build task active"
      }]
    }],
    "PostToolUse": [{
      "matcher": "^(Bash|apply_patch)$",
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/skills/build/scripts/build-status.mjs\" hook",
        "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\build\\scripts\\build-status.mjs\" hook",
        "timeout": 10,
        "statusMessage": "Recording Build tool outcome"
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/skills/build/scripts/build-status.mjs\" hook",
        "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\build\\scripts\\build-status.mjs\" hook",
        "timeout": 10,
        "statusMessage": "Reconciling Build task status"
      }]
    }]
  }
}
